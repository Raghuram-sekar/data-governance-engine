{
  "version": "1.0.0",
  "domain": "Enterprise Data Platform",
  "glossary_terms": [
    {
      "name": "Customer Identifier",
      "definition": "A unique identifier assigned to an individual customer account or profile.",
      "domain": "Customer 360",
      "synonyms": ["cust_id", "customer_id", "user_id", "client_id", "account_id"],
      "sensitivity": "INTERNAL",
      "required_tags": ["Entity:Customer", "Tier:Gold"],
      "related_metrics": ["Customer Count", "Churn Rate"]
    },
    {
      "name": "Customer Email Address",
      "definition": "Electronic mail address provided by a customer for communication, authentication, or billing.",
      "domain": "Identity & Access",
      "synonyms": ["email", "user_email", "customer_email", "mail_addr", "electronic_mail"],
      "sensitivity": "PII",
      "required_tags": ["PII", "GDPR:Restricted", "Mask:Email"],
      "related_metrics": []
    },
    {
      "name": "Social Security Number",
      "definition": "Government-issued identification number used for taxation and identity verification.",
      "domain": "Identity & Compliance",
      "synonyms": ["ssn", "tax_ssn", "social_security", "govt_id", "national_id"],
      "sensitivity": "PII",
      "required_tags": ["PII", "HighRisk:Restricted", "Mask:Full"],
      "related_metrics": []
    },
    {
      "name": "Credit Card Number",
      "definition": "Primary Account Number (PAN) associated with a credit or debit payment card.",
      "domain": "Payments & Billing",
      "synonyms": ["credit_card", "raw_credit_card", "pan", "card_number", "cc_num"],
      "sensitivity": "PCI",
      "required_tags": ["PCI-DSS", "HighRisk:Restricted", "Mask:Full"],
      "related_metrics": []
    },
    {
      "name": "Phone Number",
      "definition": "Telephone contact number of a customer or prospect.",
      "domain": "Marketing & Contact",
      "synonyms": ["phone", "phone_number", "mobile", "contact_phone", "tel_num"],
      "sensitivity": "PII",
      "required_tags": ["PII", "GDPR:Restricted"],
      "related_metrics": []
    },
    {
      "name": "Annual Recurring Revenue",
      "definition": "The predictable revenue generated by customer subscriptions on an annualized basis.",
      "domain": "Finance",
      "synonyms": ["arr", "annual_revenue", "contract_val_annual"],
      "sensitivity": "FINANCIAL",
      "required_tags": ["Executive:KPI", "Finance:Official"],
      "related_metrics": ["MRR", "Net Revenue"]
    },
    {
      "name": "Order Amount",
      "definition": "The total gross currency amount charged for an order transaction before deductions.",
      "domain": "Commerce",
      "synonyms": ["order_total", "order_amount", "gross_rev", "total_price", "txn_amount"],
      "sensitivity": "FINANCIAL",
      "required_tags": ["Finance:Transactional"],
      "related_metrics": ["Annual Recurring Revenue", "Gross Margin"]
    }
  ],
  "classification_rules": [
    {
      "rule_id": "RULE_EMAIL_PII",
      "pattern": "(?i)(.*email.*|.*mail_addr.*)",
      "classification": "PII",
      "confidence": 0.95,
      "description": "Matches email address column names",
      "masking_strategy": "MASK_EMAIL"
    },
    {
      "rule_id": "RULE_SSN_PII",
      "pattern": "(?i)(.*ssn.*|.*social_sec.*|.*national_id.*|.*tax_id.*)",
      "classification": "PII",
      "confidence": 0.98,
      "description": "Matches Social Security & Tax ID column names",
      "masking_strategy": "MASK_ALL"
    },
    {
      "rule_id": "RULE_PCI_CARD",
      "pattern": "(?i)(.*credit.*card.*|.*cc_num.*|.*pan_num.*|.*card_number.*)",
      "classification": "PCI",
      "confidence": 0.98,
      "description": "Matches Payment Card / Credit Card column names",
      "masking_strategy": "MASK_ALL"
    },
    {
      "rule_id": "RULE_PHONE_PII",
      "pattern": "(?i)(.*phone.*|.*mobile.*|.*tel_num.*)",
      "classification": "PII",
      "confidence": 0.90,
      "description": "Matches phone/contact numbers",
      "masking_strategy": "MASK_PARTIAL"
    },
    {
      "rule_id": "RULE_FINANCIAL_AMOUNT",
      "pattern": "(?i)(.*gross_rev.*|.*order_total.*|.*revenue.*|.*salary.*|.*billing_amt.*)",
      "classification": "FINANCIAL",
      "confidence": 0.85,
      "description": "Matches monetary and transactional balance fields",
      "masking_strategy": "RESTRICT_VIEW"
    }
  ],
  "metrics": [
    {
      "name": "annual_recurring_revenue",
      "display_name": "Annual Recurring Revenue (ARR)",
      "description": "Annualized sum of recurring subscription revenue.",
      "business_unit": "Finance",
      "formula": "SUM(fct_orders.order_total * 12) WHERE is_recurring = TRUE",
      "expected_source_entities": ["fct_orders"],
      "expected_columns": ["order_total", "is_recurring"]
    },

    {
      "name": "gross_order_value",
      "display_name": "Gross Order Value",
      "description": "Total value of all confirmed orders.",
      "business_unit": "Commerce",
      "formula": "SUM(fct_orders.order_total)",
      "expected_source_entities": ["fct_orders"],
      "expected_columns": ["order_total", "order_id", "order_status"]
    }
  ]
}
